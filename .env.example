# =========================================================================
# FOODRESCUE AI - DOCKER & LOCAL ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and configure the values before running docker compose
# =========================================================================

# MySQL Setup (used by MySQL container)
MYSQL_DATABASE=foodrescue
MYSQL_USER=foodrescue_user
MYSQL_PASSWORD=change_this_to_a_secure_password
MYSQL_ROOT_PASSWORD=change_this_to_a_secure_root_password

# Database URL for Spring Boot application (using the service hostname "mysql")
DB_URL=jdbc:mysql://mysql:3306/foodrescue?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=foodrescue_user
DB_PASSWORD=change_this_to_a_secure_password

# JWT Security Key (Minimum 256-bit long hex key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Application Port
PORT=8080

# File Upload Directory
UPLOAD_DIR=./uploads

# Test Configurations (For running tests locally)
TEST_DB_URL=jdbc:mysql://localhost:3306/foodrescue_test?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=your_local_mysql_password
TEST_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
